# Run outputs: keep only small, reviewable files; never trajectories.
# These rules override the repository-root .gitignore (which ignores *.log,
# *_energy.csv, opt_final.vasp, ...) for this folder.
data/runs/**
!data/runs/**/
!data/runs/**/*.csv
!data/runs/**/*.json
!data/runs/**/*_final.vasp
!data/runs/**/*.txt
!data/runs/**/*.log
# Subsampled trajectories in extended-XYZ form (raw .traj stays out).
!data/runs/**/*.xyz
# TS-verification output. mliprun writes it to a folder named ts_verify/
# (ts_verify.txt, ts_structure.vasp, ts_freq_vibrations.json); verify_ts* is
# kept as well for any file named that way.
!data/runs/**/verify_ts*
!data/runs/**/verify_ts*/**
!data/runs/**/ts_verify*
!data/runs/**/ts_verify*/**
# The as-built bilayer: build_pack.py writes md_bilayer_built.xyz from it.
!data/runs/04_md/bilayer_relax/POSCAR
# Never commit trajectories, even inside the folders re-included above.
data/runs/**/*.traj
# $REMOTE also holds the mliprun clone and the cluster copies of cluster.env
# and committee.yaml; a pull of all of $REMOTE must not bring them back
# (the clone's .git would be recorded as an embedded repository).
data/runs/mliprun/
data/runs/cluster.env
data/runs/committee.yaml
# .txt, .log and .xyz files: commit only files of 1 MB or less. Git cannot test file
# size; check with `find data/runs \( -name '*.txt' -o -name '*.log' -o -name '*.xyz' \) -size +1M`
# before committing.
