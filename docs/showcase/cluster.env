# cos-cluster settings for the showcase runs. Source it on the cluster:
#   source cluster.env
# No GPU card is chosen here: each launch picks a free card at that moment.
export REMOTE=/scratchb/juar/mliprun-showcase
# *_BIN are bin/ directories, not executables: call $UMA_BIN/mlip, $SEVENN_BIN/mlip, $MACE_BIN/mlip.
export UMA_BIN=/scratchb/juar/EWaste2GreenCat/explicit_solvation/.venv/uma/bin
export SEVENN_BIN=/scratchb/juar/EWaste2GreenCat/explicit_solvation/.venv/sevenn/bin
export MACE_BIN=/scratchb/juar/EWaste2GreenCat/explicit_solvation/.venv/mace/bin
# mliprun at main 2b3044b (TS verification + --relax-cell modes), injected
# ahead of the shared /app1-cos install (7868eb8), which must not be touched.
export PYTHONPATH=/scratchb/juar/mliprun-showcase/mliprun/src
